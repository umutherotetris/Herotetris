{
  "name": "SÜKÛN — Tasavvufî Frekans & Zikir Terapisi",
  "short_name": "SÜKÛN",
  "description": "Frekans, zikir ve tefekkürü tek çatı altında birleştiren çevrimdışı bir mekân. Ambiyans sesleri, binaural frekanslar, Delâilü'l-Hayrât, Nasuh Tövbesi, salavâtlar ve rehberli Tekke seansları.",
  "start_url": "./nero.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#0a1a16",
  "theme_color": "#0a1a16",
  "lang": "tr",
  "dir": "ltr",
  "categories": ["health", "lifestyle", "music", "education"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "shortcuts": [
    {
      "name": "Tekke — rehberli seans",
      "short_name": "Tekke",
      "description": "Nefes ve zikir seansını doğrudan başlat",
      "url": "./nero.html?git=tekke"
    },
    {
      "name": "Bugünün virdi",
      "short_name": "Vird",
      "description": "Delâilü'l-Hayrât — bugünün hizbini oku",
      "url": "./nero.html?git=vird"
    },
    {
      "name": "Zikir sayacı",
      "short_name": "Zikir",
      "description": "Zikir sekmesini aç",
      "url": "./nero.html?git=zikir"
    },
    {
      "name": "Ambiyans",
      "short_name": "Ambiyans",
      "description": "Sakinleştirici sesler",
      "url": "./nero.html?git=ambiyans"
    }
  ],
  "share_target": {
    "action": "./nero.html",
    "method": "GET",
    "params": { "title": "baslik", "text": "metin", "url": "adres" }
  },
  "file_handlers": [
    {
      "action": "./nero.html?ac=yedek",
      "accept": { "application/json": [".json"] }
    }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "ss-ambiyans.png", "sizes": "1080x2340", "type": "image/png", "form_factor": "narrow", "label": "Ambiyans — 55 sakinleştirici ses" },
    { "src": "ss-tekke.png", "sizes": "1080x2340", "type": "image/png", "form_factor": "narrow", "label": "Tekke — rehberli nefes ve zikir" },
    { "src": "ss-zikir.png", "sizes": "1080x2340", "type": "image/png", "form_factor": "narrow", "label": "Zikir — esmâ ve vird" }
  ]
}
